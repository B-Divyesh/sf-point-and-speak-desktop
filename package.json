{
  "name": "point-and-speak-desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "tauri": "tauri",
    "test": "vitest run tests/config.spec.ts && playwright test",
    "test:unit": "vitest run tests/config.spec.ts",
    "test:e2e": "playwright test",
    "test:checkout": "node scripts/verify-checkout.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
